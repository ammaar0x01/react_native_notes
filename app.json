{
  "expo": {
    "name": "Notes",
    "slug": "notes",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/logo-icon.png",
    "scheme": "notes",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/logo-foreground.png",
      "bundleIdentifier": "com.amm0x01.notes",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050807",
        "foregroundImage": "./assets/logo-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.amm0x01.notes"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050807",
          "image": "./assets/logo-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/logo-icon.png"
          }
        }
      ],
      "expo-font",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f15b1cee-9584-4261-8242-acefbb3b9e84"
      }
    }
  }
}
